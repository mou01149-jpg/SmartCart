# SmartCart AWS Cloud Configuration
# These are public frontend endpoints, not credentials.
# Never put AWS access keys, secret keys, or IAM credentials in this file.

# Existing Lambda Function URL or API Gateway base URL (include the API stage, if any).
# Examples: https://abc123.lambda-url.ap-south-1.on.aws or https://abc123.execute-api.ap-south-1.amazonaws.com/prod
VITE_API_BASE_URL=

# Amazon CloudFront Distribution URL for Product Images (e.g. https://d111111abcdef8.cloudfront.net)
# This is the image distribution, not the Amplify website origin.
VITE_CLOUDFRONT_URL=
